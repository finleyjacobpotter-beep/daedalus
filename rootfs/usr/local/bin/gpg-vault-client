#!/usr/bin/env bash
# Ansible vault-id client script backed by GPG-encrypted password files.
# Ansible calls it as: gpg-vault-client --vault-id <id>
#
#   ansible.cfg:  vault_identity_list = dev@/usr/local/bin/gpg-vault-client
#
# Decrypts ${ANSIBLE_VAULT_GPG_DIR:-./.vault-pass}/<vault-id>.gpg
# Create one with:
#   pwgen -s 48 1 | gpg --encrypt -r you@example.com -r teammate@example.com \
#       > .vault-pass/dev.gpg
set -euo pipefail

id="default"
while [[ $# -gt 0 ]]; do
  case "$1" in
    --vault-id) id="$2"; shift 2 ;;
    --vault-id=*) id="${1#*=}"; shift ;;
    *) shift ;;
  esac
done

dir="${ANSIBLE_VAULT_GPG_DIR:-$PWD/.vault-pass}"
file="${dir}/${id}.gpg"
[[ -r "$file" ]] || { echo "gpg-vault-client: no password file $file" >&2; exit 1; }

exec gpg --quiet --decrypt "$file"
