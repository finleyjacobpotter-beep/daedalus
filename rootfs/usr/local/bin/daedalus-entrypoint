#!/usr/bin/env bash
# Entrypoint for Daedalus. Wires up forwarded host agents when
# present and falls back to local ones otherwise, then execs the command.
set -euo pipefail

mode="${DAEDALUS_MODE:-operator}"

# --- SSH agent ---------------------------------------------------------------
# Operator mode: the host agent socket is forwarded to /run/host/ssh-agent.sock.
# If none was forwarded, start a private agent so `ssh-add` still works.
if [[ "$mode" != "agent" ]]; then
  if [[ -z "${SSH_AUTH_SOCK:-}" || ! -S "${SSH_AUTH_SOCK}" ]]; then
    eval "$(ssh-agent -s -a "/tmp/ssh-agent.$$.sock")" >/dev/null
    export SSH_AUTH_SOCK
  fi
else
  unset SSH_AUTH_SOCK
fi

# --- GnuPG ------------------------------------------------------------------
# If the host gpg-agent socket was forwarded, never start a second agent that
# would shadow it (it would not have the host's unlocked keys or pinentry).
gpg_sock="/run/user/$(id -u)/gnupg/S.gpg-agent"
if [[ -S "$gpg_sock" ]]; then
  export DAEDALUS_GPG_FORWARDED=1
fi

# --- libvirt ----------------------------------------------------------------
if [[ -S /var/run/libvirt/libvirt-sock ]]; then
  export LIBVIRT_DEFAULT_URI="${LIBVIRT_DEFAULT_URI:-qemu:///system}"
fi

exec "$@"
