# Python tooling baked into the image's /opt/ansible venv.
# Edit this file, then run `make lock` to regenerate requirements-tools.txt
# (fully pinned, with hashes). Projects that need a different ansible-core
# can pin their own in pyproject.toml and run it with `uv run`.
ansible-core>=2.18
ansible-lint
molecule
molecule-plugins[vagrant]   # vagrant driver -> uses vagrant-libvirt + bento boxes
yamllint
hvac                        # community.hashi_vault lookups (works against OpenBao)
jmespath                    # json_query filter
netaddr                     # ipaddr filters
passlib                     # password_hash filter
