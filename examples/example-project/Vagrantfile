# Throwaway VMs for testing Python scripts and ad-hoc role runs on real
# distros. Runs inside the daedalus against the host's libvirtd.
#   make vm-up | vm-test | vm-provision | vm-destroy     (BOXES="ubuntu rocky")
BOXES = {
  "ubuntu" => "bento/ubuntu-24.04",
  "debian" => "bento/debian-12",
  "rocky"  => "bento/rockylinux-9",
}.freeze

Vagrant.configure("2") do |config|
  # rsync: works through the libvirt socket with no NFS/virtiofs setup on the host.
  config.vm.synced_folder ".", "/vagrant", type: "rsync",
    rsync__exclude: [".git/", ".venv/", ".vagrant/", ".collections/", "__pycache__/"]

  config.vm.provider :libvirt do |lv|
    lv.memory = 1024
    lv.cpus = 1
    lv.driver = "kvm"
  end

  BOXES.each do |name, box|
    config.vm.define name do |node|
      node.vm.box = box
      node.vm.hostname = "#{name}.vagrant.test"
    end
  end

  # `make vm-provision`: apply the real playbook with the daedalus's ansible.
  config.vm.provision :ansible do |a|
    a.playbook = "playbooks/site.yml"
    a.compatibility_mode = "2.0"
    a.extra_vars = { motd_owner: "vagrant@example.com" }
  end
end
