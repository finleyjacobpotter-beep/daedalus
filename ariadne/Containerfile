# Allowlisting HTTP(S) egress proxy for `daedalus agent` sessions.
# The agent container sits on an --internal podman network with no route out;
# this proxy is the only thing attached to both that network and one with
# internet access, and it only forwards to domains in allowlist.txt.
ARG FEDORA_VERSION=44
FROM registry.fedoraproject.org/fedora-minimal:${FEDORA_VERSION}

RUN microdnf -y install --setopt=install_weak_deps=0 squid \
    && microdnf clean all \
    && install -d -o squid -g squid /var/spool/squid /var/log/squid /run/squid

COPY squid.conf /etc/squid/squid.conf
COPY allowlist.txt /etc/squid/allowlist.txt

EXPOSE 3128
CMD ["squid", "-N", "-d", "1", "-f", "/etc/squid/squid.conf"]
